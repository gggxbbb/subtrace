generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id            String    @id @default(cuid())
  username      String    @unique
  passwordHash  String
  /// ADMIN | USER（SQLite 无原生 enum，由应用层约束）
  role          String    @default("USER")
  baseCurrency  String    @default("CNY")
  /// 汇率 API 模板（{base} 占位），默认 open.er-api.com；ticket 09
  ratesApiUrl   String?
  /// 信任用户：可编写用量脚本（ADR-0007）
  canUseScripts Boolean  @default(false)
  createdAt     DateTime  @default(now())
  sessions      Session[]
  invitesCreated Invite[] @relation("creator")
  subscriptions Subscription[]
  purchases     Purchase[]
  bundles       Bundle[]
  usageRecords  UsageRecord[]
  beneficiaries Beneficiary[]
  notifyChannels NotificationChannel[]
  exchangeRates ExchangeRate[]
}

/// 汇率表（ticket 09）：原币 → 主币种；AUTO 每日 API 刷新 / MANUAL 手动钉住
model ExchangeRate {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 原币代码（USD/JPY/HKD…）；目标币 = 用户主币种
  currency   String
  /// 1 原币 = rateToBase 主币种
  rateToBase Float
  /// AUTO | MANUAL
  mode       String   @default("MANUAL")
  /// 上次自动更新失败的错误；为 null 且 AUTO 表示正常
  lastError  String?
  updatedAt  DateTime @updatedAt

  @@unique([userId, currency])
}

model Invite {
  token     String   @id
  creatorId String
  creator   User     @relation("creator", fields: [creatorId], references: [id])
  usedById  String?
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Subscription {
  id            String   @id @default(cuid())
  ownerId       String
  owner         User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name          String
  category      String?
  /// CYCLE | MANUAL（跟踪模式）
  trackingMode  String
  /// CALENDAR | FIXED_DAYS（周期模式）
  cycleKind     String?
  /// DAY | WEEK | MONTH | YEAR（CALENDAR 时）
  cycleUnit     String?
  cycleCount    Int?
  fixedDays     Int?
  /// 锚定日期：付费记录改写锚点（ADR-0001）
  anchorDate    DateTime?
  /// 标准价（原币）
  listPrice     Float?
  listCurrency  String?
  /// 标准价主币种快照：未记账周期计成本用
  listPriceBase Float?
  autoRenew     Boolean  @default(true)
  /// JSON 数组，到期前 N 天提醒
  remindDays    String   @default("[7,3,0]")
  /// ACTIVE | CANCELLED | ARCHIVED
  status        String   @default("ACTIVE")
  /// 用量类型：COUNT（计数型，逐条）| QUOTA（额度型，快照）
  usageKind     String?
  /// 用量单位：次 / 小时 / GB / 点数
  usageUnit     String?
  /// 替代单价（主币种）：不买订阅按次/按量付费的单价
  altUnitPrice  Float?
  /// 额度型：周期总额度
  quotaTotal    Float?
  /// 用量脚本（ticket 03）：JS 源码；空 = 未启用
  script        String?
  /// cron 表达式（UTC）
  scriptCron    String?
  /// 脚本级 JSON 密钥（沙箱内 env 暴露，回显脱敏）
  scriptEnv     String?
  startDate     DateTime
  createdAt     DateTime @default(now())
  payments      Payment[]
  usage         UsageRecord[]
  beneficiaries Beneficiary[]
}

/// 任务运行记录（ADR-0006）：每次周期任务运行落一条，任务大盘数据源
model JobRun {
  id         String   @id @default(cuid())
  /// reminders | rates | script:<订阅id>
  jobKey     String
  startedAt  DateTime
  durationMs Int
  /// OK | FAIL
  status     String
  /// 摘要/日志（截断存储）
  message    String?

  @@index([jobKey, startedAt])
}

/// 通知渠道（ticket 08）：WEBHOOK（POST JSON）| EMAIL（SMTP，经 nodemailer）
model NotificationChannel {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// WEBHOOK | EMAIL
  kind      String
  name      String
  /// JSON：WEBHOOK={url}；EMAIL={host,port,secure,user,pass,from,to}
  config    String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  deliveries ReminderDelivery[]
}

/// 提醒投递记录：成功/失败都落库，(渠道,订阅,到期日,偏移) 唯一防重发
model ReminderDelivery {
  id             String   @id @default(cuid())
  channelId      String
  channel        NotificationChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  subscriptionId String
  /// 命中的到期日（UTC 零点）
  dueDate        DateTime
  /// 提前天数（7/3/0 之一）
  dayOffset      Int
  /// OK | FAIL
  status         String
  error          String?
  sentAt         DateTime @default(now())

  @@unique([channelId, subscriptionId, dueDate, dayOffset])
}

/// 受益实体（ADR-0003）：用户（家庭共享）或物品（iCloud 之于多设备）；份额 = 权重 / Σ权重
model Beneficiary {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  /// USER | ITEM
  kind           String
  /// kind=USER 时指向用户
  userId         String?
  user           User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// kind=ITEM 时指向物品
  purchaseId     String?
  purchase       Purchase?    @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  /// 权重（默认 1，均分）；改权重全局重算
  weight         Float        @default(1)
  createdAt      DateTime     @default(now())
}

model UsageRecord {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  date           DateTime
  quantity       Float
  /// DELTA（增量，计数型）| TOTAL（累计快照，额度型）
  kind           String       @default("DELTA")
  /// 本次单价（主币种快照）；为空用订阅默认替代单价
  unitPrice      Float?
  /// 额度型：当月总额度（快照）；为空用订阅默认
  quotaTotal     Float?
  /// MANUAL | SCRIPT
  source         String       @default("MANUAL")
  createdAt      DateTime     @default(now())
}

model Payment {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  /// 实付（原币）；null = 金额未知（ticket 12，只记区间的存量订阅）
  amount         Float?
  currency       String?
  /// 主币种快照（ADR-0004）；null = 金额未知
  amountBase     Float?
  /// 退款（主币种），成本按净额
  refundedBase   Float        @default(0)
  paidAt         DateTime
  /// 服务区间 [periodStart, periodEnd)，到期日唯一事实源
  periodStart    DateTime
  periodEnd      DateTime
  /// AUTO | MANUAL | PROMO | BUNDLE
  source         String
  /// BUNDLE 来源时指向联合会员（归属挂在付费记录上，ADR-0002）
  bundleId       String?
  bundle         Bundle?      @relation(fields: [bundleId], references: [id], onDelete: SetNull)
  note           String?
  createdAt      DateTime     @default(now())
}

model Bundle {
  id              String    @id @default(cuid())
  ownerId         String
  owner           User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name            String
  /// 打包实付（原币）
  totalAmount     Float
  currency        String
  /// 主币种快照（ADR-0004）
  totalAmountBase Float
  periodStart     DateTime
  periodEnd       DateTime
  /// 归档（隐藏于列表）
  archived        Boolean  @default(false)
  createdAt       DateTime  @default(now())
  payments        Payment[]
}

model Purchase {
  id           String   @id @default(cuid())
  ownerId      String
  owner        User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name         String
  category     String?
  /// 买入价（原币）
  amount       Float
  currency     String
  /// 主币种快照（ADR-0004）
  amountBase   Float
  purchaseDate DateTime
  /// 预期寿命天数（回本模型）
  expectedDays Int?
  /// IN_USE | RETIRED | SOLD
  status       String   @default("IN_USE")
  /// 报废/卖出日期
  endDate      DateTime?
  /// 残值（主币种）
  resaleBase   Float?
  /// 归档（隐藏于列表与统计，不影响状态机）
  archived     Boolean  @default(false)
  createdAt    DateTime @default(now())
  beneficiaries Beneficiary[]
  incomes      PurchaseIncome[]
  events       PurchaseEvent[]
}

/// 一次性追加费用事件（配件/维修等）：计入物品净额、与买入价共用同一摊销窗口
model PurchaseEvent {
  id         String   @id @default(cuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  /// ACCESSORY | REPAIR | OTHER
  kind       String
  /// 金额（原币）
  amount     Float
  currency   String   @default("CNY")
  /// 主币种快照（ADR-0004）
  amountBase Float
  date       DateTime
  /// 维修可选：延长预期寿命（天）
  extendDays Int?
  note       String?
  createdAt  DateTime @default(now())
}

/// 物品创造的收益（出租、返利等），抵减 TCO
model PurchaseIncome {
  id         String   @id @default(cuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  /// 收益（原币）
  amount     Float
  currency   String   @default("CNY")
  /// 主币种快照（ADR-0004）
  amountBase Float
  date       DateTime
  /// 来源说明：出租 / 返利 / 其他
  note       String?
  createdAt  DateTime @default(now())
}
