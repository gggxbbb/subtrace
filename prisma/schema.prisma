generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id            String    @id @default(cuid())
  username      String    @unique
  passwordHash  String
  /// ADMIN | USER（SQLite 无原生 enum，由应用层约束）
  role          String    @default("USER")
  baseCurrency  String    @default("CNY")
  createdAt     DateTime  @default(now())
  sessions      Session[]
  invitesCreated Invite[] @relation("creator")
  subscriptions Subscription[]
  purchases     Purchase[]
  bundles       Bundle[]
  usageRecords  UsageRecord[]
}

model Invite {
  token     String   @id
  creatorId String
  creator   User     @relation("creator", fields: [creatorId], references: [id])
  usedById  String?
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Subscription {
  id            String   @id @default(cuid())
  ownerId       String
  owner         User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name          String
  category      String?
  /// CYCLE | MANUAL（跟踪模式）
  trackingMode  String
  /// CALENDAR | FIXED_DAYS（周期模式）
  cycleKind     String?
  /// DAY | WEEK | MONTH | YEAR（CALENDAR 时）
  cycleUnit     String?
  cycleCount    Int?
  fixedDays     Int?
  /// 锚定日期：付费记录改写锚点（ADR-0001）
  anchorDate    DateTime?
  /// 标准价（原币）
  listPrice     Float?
  listCurrency  String?
  /// 标准价主币种快照：未记账周期计成本用
  listPriceBase Float?
  autoRenew     Boolean  @default(true)
  /// JSON 数组，到期前 N 天提醒
  remindDays    String   @default("[7,3,0]")
  /// ACTIVE | CANCELLED | ARCHIVED
  status        String   @default("ACTIVE")
  /// 用量类型：COUNT（计数型，逐条）| QUOTA（额度型，快照）
  usageKind     String?
  /// 用量单位：次 / 小时 / GB / 点数
  usageUnit     String?
  /// 替代单价（主币种）：不买订阅按次/按量付费的单价
  altUnitPrice  Float?
  /// 额度型：周期总额度
  quotaTotal    Float?
  startDate     DateTime
  createdAt     DateTime @default(now())
  payments      Payment[]
  usage         UsageRecord[]
}

model UsageRecord {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  date           DateTime
  quantity       Float
  /// DELTA（增量，计数型）| TOTAL（累计快照，额度型）
  kind           String       @default("DELTA")
  /// MANUAL | SCRIPT
  source         String       @default("MANUAL")
  createdAt      DateTime     @default(now())
}

model Payment {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  /// 实付（原币）
  amount         Float
  currency       String
  /// 主币种快照（ADR-0004）
  amountBase     Float
  /// 退款（主币种），成本按净额
  refundedBase   Float        @default(0)
  paidAt         DateTime
  /// 服务区间 [periodStart, periodEnd)，到期日唯一事实源
  periodStart    DateTime
  periodEnd      DateTime
  /// AUTO | MANUAL | PROMO | BUNDLE
  source         String
  /// BUNDLE 来源时指向联合会员（归属挂在付费记录上，ADR-0002）
  bundleId       String?
  bundle         Bundle?      @relation(fields: [bundleId], references: [id], onDelete: SetNull)
  note           String?
  createdAt      DateTime     @default(now())
}

model Bundle {
  id              String    @id @default(cuid())
  ownerId         String
  owner           User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name            String
  /// 打包实付（原币）
  totalAmount     Float
  currency        String
  /// 主币种快照（ADR-0004）
  totalAmountBase Float
  periodStart     DateTime
  periodEnd       DateTime
  createdAt       DateTime  @default(now())
  payments        Payment[]
}

model Purchase {
  id           String   @id @default(cuid())
  ownerId      String
  owner        User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name         String
  category     String?
  /// 买入价（原币）
  amount       Float
  currency     String
  /// 主币种快照（ADR-0004）
  amountBase   Float
  purchaseDate DateTime
  /// 预期寿命天数（回本模型）
  expectedDays Int?
  /// IN_USE | RETIRED | SOLD
  status       String   @default("IN_USE")
  /// 报废/卖出日期
  endDate      DateTime?
  /// 残值（主币种）
  resaleBase   Float?
  createdAt    DateTime @default(now())
}
